generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  SUPERVISOR
  FIELD_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
}

enum VisitStatus {
  PENDING
  VERIFIED
  UNVERIFIED
  REJECTED
}

enum AuditQuestionType {
  YES_NO
  TEXT
}

enum TaskStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum CampaignStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  phone        String?
  role         UserRole   @default(FIELD_STAFF)
  status       UserStatus @default(ACTIVE)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  checkIns CheckInOut[]
  visits   Visit[]

  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationLogs LocationLog[]

  @@index([role])
  @@index([status])
  @@index([siteId])
  @@map("users")
}

model Site {
  id        String     @id @default(uuid())
  name      String
  siteCode  String     @unique
  address   String?
  city      String?
  state     String?
  pincode   String?
  latitude  Float?
  longitude Float?
  status    SiteStatus @default(ACTIVE)

  users    User[]
  checkIns CheckInOut[]
  visits   Visit[]
  tasks    Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([city])
  @@map("sites")
}

model CheckInOut {
  id String @id @default(uuid())

  userId String
  siteId String

  checkInAt  DateTime
  checkOutAt DateTime?

  checkInLatitude  Float?
  checkInLongitude Float?

  checkOutLatitude  Float?
  checkOutLongitude Float?

  distanceTravelled Float?
  status            AttendanceStatus @default(CHECKED_IN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  site Site @relation(fields: [siteId], references: [id])

  @@index([userId])
  @@index([siteId])
  @@index([checkInAt])
  @@index([status])
  @@map("check_ins")
}

model Visit {
  id String @id @default(uuid())

  userId String
  siteId String

  visitAt    DateTime
  reportType String?
  clientName String?
  branch     String?
  region     String?

  // GPS captured from Supervisor phone
  latitude  Float?
  longitude Float?

  // Visit photo stored in Google Drive
  photoUrl    String?
  photoFileId String?

  status VisitStatus @default(PENDING)

  notes String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  auditSubmission AuditSubmission?

  user User @relation(fields: [userId], references: [id])
  site Site @relation(fields: [siteId], references: [id])

  @@index([userId])
  @@index([siteId])
  @@index([visitAt])
  @@index([status])
  @@index([clientName])
  @@map("visits")
}

model Campaign {
  id          String         @id @default(uuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      CampaignStatus @default(ACTIVE)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id String @id @default(uuid())

  title       String
  description String?
  clientEmail String?

  status   TaskStatus   @default(SCHEDULED)
  priority TaskPriority @default(MEDIUM)

  scheduledAt DateTime

  assignedToId String
  assignedById String

  siteId     String
  campaignId String?

  completedAt DateTime?

  assignedTo User      @relation("AssignedTasks", fields: [assignedToId], references: [id])
  assignedBy User      @relation("CreatedTasks", fields: [assignedById], references: [id])
  site       Site      @relation(fields: [siteId], references: [id])
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  showInAdvance   Boolean @default(true)
  showAfterMissed Boolean @default(true)
  wholeDay        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([siteId])
  @@index([status])
  @@index([scheduledAt])
}

model AuditTemplate {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  questions   AuditQuestion[]
  submissions AuditSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("audit_templates")
}

model AuditQuestion {
  id         String @id @default(uuid())
  templateId String

  questionNo Int
  question   String
  type       AuditQuestionType @default(YES_NO)
  isRequired Boolean           @default(true)
  isActive   Boolean           @default(true)

  template AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers  AuditAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([questionNo])
  @@map("audit_questions")
}

model AuditSubmission {
  id String @id @default(uuid())

  visitId    String @unique
  templateId String

  submittedAt DateTime @default(now())

  visit    Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  template AuditTemplate @relation(fields: [templateId], references: [id])
  answers  AuditAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([submittedAt])
  @@map("audit_submissions")
}

model AuditAnswer {
  id String @id @default(uuid())

  submissionId String
  questionId   String

  questionNo   Int
  questionText String

  booleanValue Boolean?
  textValue    String?

  submission AuditSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   AuditQuestion   @relation(fields: [questionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@index([questionId])
  @@map("audit_answers")
}

model LocationLog {
  id           String   @id @default(uuid())
  userId       String
  latitude     Float
  longitude    Float
  batteryLevel Int?
  recordedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordedAt])
}
